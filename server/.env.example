# Copy to .env (git-ignored). On Bloxity Legion none of this is needed: it injects
# PORT, CLIENT_ORIGIN, MONGODB_URI, BLOXITY_GAME_ID, BLOXITY_CHANNEL and POD_NAME.
PORT=2567
# Extra allowed browser origins, comma-separated.
CLIENT_ORIGINS=
# Leave unset locally to save to data/game.db (SQLite); set to use MongoDB instead.
# MONGODB_URI=mongodb://localhost:27017/slide
