# Nothing about Boxity goes in here: the platform tells the game which environment it's
# in (prod, stage or local) at runtime - see src/bloxity/env.js.
#
# The dev server tells a standalone page it's on a Boxity platform running on this
# machine (localhost:3000/4000). To sign in against the real bloxity.io while
# developing instead, start it with:   BLOXITY_DEV_ENV=prod npm run dev

# Hosted on Boxity Legion: join through its matchmaker (the deploy workflow sets this
# for hosted builds). It's the hosting id, not an environment.
# VITE_LEGION_GAME_ID=1-slide-downhill

# Or a game server (Colyseus) reached directly. Leave both unset in development to use
# http://<host>:2567; a production build with neither plays offline with a local save.
# VITE_SERVER_URL=https://game.example.com
